    },
    {
      "endpoint": "GET /reports/revenue",
      "surface": "db",
      "failure": "loud",
      "why": "Migration 0002 drops total_price column, causing SUM(total_price) in SQL reports to raise a database error resulting in HTTP 500."
    }
  ],
  "migration_notes": "Orders v2 changes how an order's money, customer and payment state are represented. Consumers should ship tolerant readers that accept v1 and v2 at the same time. REST clients should read total.amount_minor when present, else round(total_price * 100), and read customer.display_name when present, else customer_name. gRPC clients should vendor the v2 proto and prefer total / customer when HasField(...) is true, treating both PENDING and AWAITING_PAYMENT as not payable. SQL reports must check alembic_version.version_num or handle the schema transition from total_price to total_minor."
}
