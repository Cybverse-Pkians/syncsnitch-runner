+from dataclasses import dataclass
+from typing import Optional
+from decimal import Decimal
+
+@dataclass(frozen=True)
+class OrderView:
+    order_id: str
+    customer_name: str
+    amount_minor: int
+    currency: str
+    status: str
+    created_at: Optional[str] = None
+
+def normalize_status(value: str) -> str:
+    if value.startswith("ORDER_STATUS_"):
+        value = value[len("ORDER_STATUS_"):]
+    if value == "PENDING":
+        return "AWAITING_PAYMENT"
+    return value
+
+def from_rest(payload: dict) -> OrderView:
+    if "total" in payload:
+        customer_name = payload["customer"]["display_name"]
+        amount = payload["total"]["amount_minor"]
+        currency = payload["total"]["currency"]
+    else:
+        customer_name = payload["customer_name"]
+        amount = int(Decimal(str(payload["total_price"])) * 100)
+        currency = "USD"
+    
+    return OrderView(
+        order_id=payload["order_id"],
+        customer_name=customer_name,
+        amount_minor=amount,
+        currency=currency,
+        status=normalize_status(payload["status"]),
+        created_at=payload.get("created_at")
+    )
